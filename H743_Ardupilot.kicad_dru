(version 1)

# LEVIA-derived mechanical outline intentionally intersects the grounded
# mounting-hole copper at H1-H4. Keep the outline unchanged and allow this
# local overlap only for those four mounting-hole footprints.
(rule "FC01 mounting holes at board edge"
    (constraint edge_clearance (min -1mm))
    (condition "A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4')"))

# TI RAK0009A (LMR60430-Q1) manufacturer land pattern has 0.125 mm internal
# copper spacing. Preserve the package geometry instead of altering its pads.
(rule "U4 TI RAK0009A internal clearance"
    (constraint clearance (min 0.125mm))
    (condition "A.memberOfFootprint('U4') && B.memberOfFootprint('U4')"))

# Bosch BMP581 assembly recommendation removes solder mask below the sensor.
# The resulting mask bridges around its pads are intentional and local to U12.
(rule "U12 BMP581 intentional mask opening"
    (constraint bridged_mask)
    (severity ignore)
    (condition "A.memberOfFootprint('U12')"))
